diff -ruN -x '*.o' -x volt -x volt.exe -x volt_shim_native -x .git voltbuild/utils/glibc_rand.h voltwin/utils/glibc_rand.h
--- voltbuild/utils/glibc_rand.h	1969-12-31 16:00:00.000000000 -0800
+++ voltwin/utils/glibc_rand.h	2026-09-28 16:31:44.865166067 -0700
@@ -0,0 +1,39 @@
+// Windows-build portability shim (not part of upstream VOLT).
+// msvcrt's rand() has RAND_MAX = 32767 and a different generator, so std::rand-based shuffles differ from the
+// Linux build (and are strongly biased for n > 32768). This header reproduces glibc's default rand()/srand()
+// (TYPE_3 additive feedback generator) and libstdc++'s std::random_shuffle loop, so that the Windows executable
+// makes exactly the same random choices as the pinned Linux build.
+#pragma once
+#include <cstdint>
+#include <algorithm>
+namespace glibcrand {
+inline int32_t buf[31]; inline int fptr = 3, rptr = 0; inline bool seeded = false;
+inline void srand_(unsigned int seed) {
+  int32_t *r = buf;
+  int32_t word = (int32_t)seed; if (seed == 0) word = 1;
+  r[0] = word;
+  for (int i = 1; i < 31; ++i) {
+    long hi = word / 127773, lo = word % 127773;
+    word = 16807 * lo - 2836 * hi;
+    if (word < 0) word += 2147483647;
+    r[i] = word;
+  }
+  fptr = 3; rptr = 0; seeded = true;
+  for (int i = 0; i < 310; ++i) { // discard 310 outputs as glibc does
+    uint32_t v = (uint32_t)r[fptr] + (uint32_t)r[rptr]; r[fptr] = (int32_t)v;
+    if (++fptr >= 31) { fptr = 0; ++rptr; } else if (++rptr >= 31) rptr = 0;
+  }
+}
+inline int rand_() {
+  if (!seeded) srand_(1);
+  int32_t *r = buf;
+  uint32_t v = (uint32_t)r[fptr] + (uint32_t)r[rptr]; r[fptr] = (int32_t)v;
+  int result = (int)(v >> 1);
+  if (++fptr >= 31) { fptr = 0; ++rptr; } else if (++rptr >= 31) rptr = 0;
+  return result;
+}
+template <typename It> inline void random_shuffle_(It first, It last) {
+  if (first != last)
+    for (It i = first + 1; i != last; ++i) { It j = first + rand_() % ((i - first) + 1); if (i != j) std::iter_swap(i, j); }
+}
+}
